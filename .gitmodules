[submodule "zellij/.config/zellij/yazelix"]
	path = zellij/.config/zellij/yazelix
	url = ./yazelix
[submodule "oh-my-zsh/.oh-my-zsh"]
	path = oh-my-zsh/.oh-my-zsh
	url = git@github.com:ohmyzsh/ohmyzsh.git
[submodule "oh-my-zsh-custom/.oh-my-zsh-custom/plugins/zsh-vi-mode"]
	path = oh-my-zsh-custom/.oh-my-zsh-custom/plugins/zsh-vi-mode
	url = https://github.com/jeffreytse/zsh-vi-mode.git
